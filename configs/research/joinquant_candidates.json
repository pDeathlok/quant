    {
      "name": "jq_MFI14",
      "family": "price",
      "formula": "100*positive_typical_price_flow14/(positive_flow14+negative_flow14)"
    },
    {
      "name": "jq_arron_up_25",
      "family": "price",
      "formula": "100*(25-days_since_latest_highest_high_in25)/25"
    },
    {
      "name": "jq_arron_down_25",
      "family": "price",
      "formula": "100*(25-days_since_latest_lowest_low_in25)/25"
    },
    {
      "name": "jq_cash_earnings_to_price_ratio",
      "family": "finance",
      "formula": "CFO_TTM/(total_mv*10000)"
    },
    {
      "name": "jq_operating_profit_yield_proxy",
      "family": "finance",
      "formula": "operating_profit_TTM/(total_mv*10000)"
    },
    {
      "name": "jq_operating_profit_ratio",
      "family": "finance",
      "formula": "operating_profit_TTM/revenue_TTM"
    },
    {
      "name": "jq_operating_revenue_growth_rate",
      "family": "finance",
      "formula": "revenue_TTM/prior_year_revenue_TTM-1; positive base"
