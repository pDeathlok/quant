# Required for Tushare data refresh.
TUSHARE_TOKEN=replace_with_your_tushare_token

# Production market-data storage.
# Keep real usernames/passwords in your local .env only; never commit them.
MARKET_DATA_BACKEND=mysql
MARKET_DATA_SQL_URL=mysql+pymysql://quant_user:<db-password>@127.0.0.1:3306/quant?charset=utf8mb4
MARKET_DATA_ROOT=data/raw

# Keep a parquet mirror while research scripts are being migrated to SQL reads.
MARKET_DATA_MIRROR_PARQUET=1

# Optional storage timeouts in seconds.
MARKET_DATA_SQL_CONNECT_TIMEOUT=10
MARKET_DATA_SQL_READ_TIMEOUT=60
MARKET_DATA_SQL_WRITE_TIMEOUT=60

# Optional daily-pipeline concurrency and Tushare rate controls.
ROUTINE_DAILY_LOOKBACK_DAYS=0
ROUTINE_DAILY_WORKERS=4
ROUTINE_DAILY_SLEEP=0.08
ROUTINE_DAILY_FINAL_RETRY_ROUNDS=2
ROUTINE_DAILY_FINAL_RETRY_WORKERS=4
ROUTINE_DAILY_FINAL_RETRY_SLEEP=0.8
ROUTINE_FEATURE_WORKERS=8
ROUTINE_MODEL_SCORE_WORKERS=4
ROUTINE_CHAN_WORKERS=4
ROUTINE_DAILY_BASIC_MIN_MATCH_RATE=0.98
ROUTINE_WEB_WORKSPACE_WORKERS=6
SIMILAR_PATTERN_CACHE_WORKERS=4
