# Required for Tushare data refresh.
TUSHARE_TOKEN=replace_with_your_tushare_token

# Production market-data storage.
# Keep real usernames/passwords in your local .env only; never commit them.
MARKET_DATA_BACKEND=mysql
MARKET_DATA_SQL_URL=mysql+pymysql://quant_user:<db-password>@127.0.0.1:3306/quant?charset=utf8mb4

# Keep a parquet mirror while research scripts are being migrated to SQL reads.
MARKET_DATA_MIRROR_PARQUET=1
